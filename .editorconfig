root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{rs,toml}]
indent_style = space
indent_size = 4

[*.{dart,yaml,yml,json}]
indent_style = space
indent_size = 2

[*.proto]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
